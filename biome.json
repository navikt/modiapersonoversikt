{
    "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
    "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
    "files": { "ignoreUnknown": true, "includes": ["**", "!**/*.css"] },
    "formatter": {
        "enabled": true,
        "formatWithErrors": false,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineEnding": "lf",
        "lineWidth": 120,
        "attributePosition": "auto",
        "bracketSpacing": true,
        "includes": ["**", "!**/*.gen.ts", "!**/generated/modiapersonoversikt-api.ts"]
    },
    "markdown": { "formatter": { "enabled": false } },
    "yaml": { "formatter": { "enabled": false } },
    "assist": { "actions": { "source": { "organizeImports": "on" } } },
    "linter": {
        "enabled": true,
        "rules": {
            "nursery": {},
            "preset": "recommended",
            "suspicious": {
                "noArrayIndexKey": "warn"
            },
            "correctness": {
                "useExhaustiveDependencies": "warn"
            },
            "style": {
                "useConsistentCurlyBraces": "warn"
            }
        },
        "includes": ["**", "!**/build/", "!**/src/mock/mock-websocket.ts"]
    },
    "javascript": {
        "formatter": {
            "jsxQuoteStyle": "double",
            "quoteProperties": "asNeeded",
            "trailingCommas": "none",
            "quoteStyle": "single",
            "bracketSpacing": true
        },
        "globals": ["JSX", "React"]
    },
    "overrides": [
        {
            "includes": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts"],
            "linter": {
                "rules": {
                    "correctness": {
                        "noUndeclaredVariables": "error",
                        "noConstAssign": "off",
                        "noGlobalObjectCalls": "off",
                        "noInvalidBuiltinInstantiation": "off",
                        "noInvalidConstructorSuper": "off",
                        "noSetterReturn": "off",
                        "noUnreachable": "off",
                        "noUnreachableSuper": "off",
                        "noUnusedImports": "error",
                        "noUnusedVariables": "error"
                    },
                    "style": {
                        "useConst": "error"
                    },
                    "suspicious": {
                        "noClassAssign": "off",
                        "noDuplicateClassMembers": "off",
                        "noDuplicateObjectKeys": "off",
                        "noDuplicateParameters": "off",
                        "noFunctionAssign": "off",
                        "noImportAssign": "off",
                        "noRedeclare": "off",
                        "noUnsafeNegation": "off",
                        "useGetterReturn": "off",
                        "noVar": "error"
                    },
                    "complexity": {
                        "noArguments": "error"
                    }
                }
            }
        },
        {
            "includes": [
                "src/**",
                "!src/app/personside/**",
                "!src/app/routes/**",
                "!src/app/PersonOppslagHandler/**",
                "!src/app/LegacyAppContainer.tsx",
                "!src/app/GlobalStyling.ts",
                "!src/app/IeMacStyling.tsx",
                "!src/redux/**",
                "!src/routes/person.tsx",
                "!src/routes/person/**",
                "!src/routes/saker.tsx",
                "!src/routes/dokument.tsx",
                "!src/routeTree.gen.ts",
                "!src/components/autocomplete-textarea/**",
                "!src/utils/print/MeldingerPrintMarkup.tsx",
                "!src/rest/resources/dialogResource.tsx",
                "!src/test/testStore.ts",
                "!src/test/LegacyTestprovider.tsx"
            ],
            "linter": {
                "rules": {
                    "style": {
                        "noRestrictedImports": {
                            "level": "error",
                            "options": {
                                "patterns": [
                                    {
                                        "group": [
                                            "**/personside",
                                            "**/personside/**",
                                            "**/app/routes",
                                            "**/app/routes/**",
                                            "**/routes/routing",
                                            "**/routes/routing.*",
                                            "**/PersonOppslagHandler",
                                            "**/PersonOppslagHandler/**",
                                            "**/LegacyAppContainer",
                                            "**/LegacyAppContainer.*",
                                            "**/GlobalStyling",
                                            "**/GlobalStyling.*",
                                            "**/IeMacStyling",
                                            "**/IeMacStyling.*",
                                            "**/redux",
                                            "**/redux/**",
                                            "react-redux",
                                            "react-redux/**",
                                            "redux-thunk",
                                            "redux-thunk/**",
                                            "redux-devtools-extension",
                                            "redux-devtools-extension/**",
                                            "**/routes/person",
                                            "**/routes/person.*",
                                            "**/routes/person/**",
                                            "**/routes/saker",
                                            "**/routes/saker.*",
                                            "**/routes/dokument",
                                            "**/routes/dokument.*",
                                            "**/autocomplete-textarea",
                                            "**/autocomplete-textarea/**",
                                            "**/MeldingerPrintMarkup",
                                            "**/MeldingerPrintMarkup.*",
                                            "**/dialogResource",
                                            "**/dialogResource.*",
                                            "**/testStore",
                                            "**/testStore.*",
                                            "**/LegacyTestprovider",
                                            "**/LegacyTestprovider.*"
                                        ],
                                        "message": "Ny og felles kode skal ikke importere legacy-kode. Bruk eller flytt funksjonaliteten til en felles modul."
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        },
        {
            "includes": ["**/*.test.ts", "**/*.test.tsx", "**/setupTests.ts"],
            "javascript": {
                "globals": [
                    "expect",
                    "test",
                    "describe",
                    "it",
                    "beforeEach",
                    "beforeAll",
                    "vi",
                    "fail",
                    "assert",
                    "afterAll",
                    "afterEach"
                ]
            }
        }
    ]
}
