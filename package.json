{
    "name": "modiapersonoversikt",
    "version": "0.4.2",
    "private": false,
    "license": "MIT",
    "packageManager": "pnpm@11.6.0",
    "main": "build/dist/index.js",
    "type": "module",
    "files": [
        "build/dist/"
    ],
    "engines": {
        "node": "^24.0",
        "pnpm": ">=11.6.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/navikt/modiapersonoversikt"
    },
    "scripts": {
        "postinstall": "msw init public --no-save",
        "start": "vite",
        "start:dev": "VITE_MOCK_ENABLED=false vite",
        "build": "vite build",
        "test": "vitest",
        "lint": "biome check",
        "lint:compiler": "eslint src",
        "fix": "biome check --write",
        "lint:ci": "biome ci --reporter=github",
        "lint-staged": "lint-staged",
        "types": "tsc --noEmit",
        "gen:routes": "tsr generate",
        "generate": "openapi-typescript https://modiapersonoversikt-api.intern.dev.nav.no/modiapersonoversikt-api/v3/api-docs -o src/generated/modiapersonoversikt-api.ts --enum --root-types --root-types-no-schema-prefix",
        "generate:local": "openapi-typescript http://127.0.0.1:8086/modiapersonoversikt-api/v3/api-docs -o src/generated/modiapersonoversikt-api.ts --enum --root-types --root-types-no-schema-prefix",
        "tsc": "tsc",
        "knip": "knip --exclude enumMembers"
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
    },
    "lint-staged": {
        "*.{js,ts,tsx,json,less,css,md}": [
            "biome format --write"
        ]
    },
