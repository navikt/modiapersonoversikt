        "tsc": "tsc",
        "knip": "knip --exclude enumMembers"
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
    },
    "lint-staged": {
        "*.{js,ts,tsx,json,less,css,md}": [
            "biome format --write"
        ]
    },
